{
  "name": "react-vite-tailwind",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "data:catalog": "node scripts/export-dish-catalog.mjs",
    "data:stages": "npm run data:catalog && node scripts/py.cjs scripts/build_stage_data.py",
    "photos:fetch": "node scripts/py.cjs scripts/fetch_food_photos.py",
    "photos:plan": "node scripts/py.cjs scripts/fetch_food_photos.py --dry-run",
    "photos:verify": "node scripts/py.cjs scripts/fetch_food_photos.py --verify",
    "photos:import": "node scripts/py.cjs scripts/import_verified_photos.py",
    "photos:credits": "node scripts/py.cjs scripts/generate-photography-credits.py",
    "audit:images": "node scripts/py.cjs scripts/audit_image_mappings.py",
    "atlas:check": "esbuild scripts/validate-atlas.ts --bundle --format=esm --platform=node --outfile=.cache/validate-atlas.mjs --log-level=warning && node .cache/validate-atlas.mjs",
    "ui:smoke": "esbuild scripts/ui-smoke.tsx --bundle --format=cjs --platform=node --jsx=automatic --loader:.json=json --outfile=.cache/ui-smoke.cjs --log-level=warning && node .cache/ui-smoke.cjs"
  },
  "dependencies": {
    "@types/three": "^0.186.0",
    "clsx": "2.1.1",
    "framer-motion": "^14.6.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.42.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.4.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.3.2",
    "vite-plugin-singlefile": "2.3.0"
  }
}
